{
  "name": "aamu-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aamu – clinical decision support for earlier cancer diagnosis (Junction 2026, AstraZeneca challenge). Synthetic data only.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,yellow \"vite\" \"tsx watch server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "extract": "tsx scripts/extract.ts"
  },
  "dependencies": {
    "@fontsource/google-sans": "^5.3.2",
    "@fontsource/google-sans-code": "^5.3.2",
    "@google/genai": "^1.10.0",
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  }
}
