# Copy to .env (gitignored). The key is read only by the server (server/, scripts/), never by the browser.
# Free key: https://aistudio.google.com/apikey  (no billing needed)
# Free-tier input may be used by Google to improve its products: synthetic data only.
GEMINI_API_KEY=

# Optional. The "-latest" alias follows Google's current Flash-Lite model.
# Pin a specific model (e.g. one listed in AI Studio) if you want stable output.
GEMINI_MODEL=gemini-flash-lite-latest

# Optional. Server port (Vite proxies /api here).
PORT=8787
